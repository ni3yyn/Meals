<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeMealsBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mida_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/mida_forest</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Mida" parent="@style/ThemeMealsBase" />

    <style name="Theme.Mida.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mida_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mida_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Mida</item>
    </style>
</resources>
