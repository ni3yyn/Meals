{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ni3yyn/Meals/main/data/products/taxonomy.schema.json",
  "title": "Midati canonical food taxonomy",
  "description": "Canonical multilingual category hierarchy. Stable IDs are identifiers; localized labels are display data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "languageCodes",
    "categories"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "languageCodes": {
      "const": [
        "ar",
        "en",
        "fr"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "localizedNames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ar",
        "en",
        "fr"
      ],
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "names",
        "subcategories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^foodcat-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "names": {
          "$ref": "#/$defs/localizedNames"
        },
        "subcategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subcategory"
          }
        }
      }
    },
    "subcategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "names"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^foodsub-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "names": {
          "$ref": "#/$defs/localizedNames"
        }
      }
    }
  }
}
